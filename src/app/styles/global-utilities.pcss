@layer utilities {
  .wrap-break-word {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .contain-content {
    contain: content;
  }

  .scrollbar-gutter-stable {
    scrollbar-gutter: stable;
  }

  .scrollbar-none {
    scrollbar-width: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: color-mix(
        in oklch,
        var(--muted-foreground) 28%,
        transparent
      )
      transparent;
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 0.5rem;
    height: 0.5rem;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: color-mix(in oklch, var(--muted-foreground) 28%, transparent);
    background-clip: padding-box;
  }

  .scroll-fade-b {
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 1.5rem,
      black calc(100% - 2.5rem),
      transparent 100%
    );
  }

  .scroll-fade-x {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 1rem,
      black calc(100% - 1rem),
      transparent 100%
    );
  }

  .shimmer {
    background: linear-gradient(
      110deg,
      var(--muted-foreground) 0%,
      color-mix(in oklch, var(--foreground) 45%, transparent) 35%,
      var(--muted-foreground) 70%
    );
    background-size: 220% 100%;
    background-clip: text;
    color: transparent;
    animation: ai-hub-shimmer 1.8s linear infinite;
  }

  @keyframes ai-hub-shimmer {
    to {
      background-position-x: -220%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer {
      animation: none;
    }
  }
}
